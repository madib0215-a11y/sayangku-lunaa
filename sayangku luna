<!DOCTYPE html>
<html>
<head>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&family=Pacifico&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #ffebee;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            font-family: 'Quicksand', sans-serif; /* Font lucu */
            overflow-x: hidden;
        }
        .card {
            background: white;
            padding: 25px;
            border-radius: 25px;
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
            text-align: center;
            width: 85%;
            max-width: 400px;
            z-index: 1;
        }
        h1 { 
            color: #e91e63; 
            font-family: 'Pacifico', cursive; /* Font sambung menggemaskan */
            font-size: 1.8em;
            margin-bottom: 10px;
        }
        
        /* Gaya untuk banyak foto (Slider) */
        .photo-container {
            width: 180px;
            height: 180px;
            margin: 0 auto 20px;
            position: relative;
            border: 5px solid #ff80ab;
            border-radius: 50%;
            overflow: hidden;
        }
        .photo-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            left: 0;
            opacity: 0;
            transition: opacity 1s ease-in-out;
        }
        .photo-container img.active { opacity: 1; }

        #typing-text { 
            color: #555; 
            font-size: 1.1em; 
            line-height: 1.6;
            min-height: 80px;
        }
        
        .heart {
            position: absolute;
            color: #ff4081;
            font-size: 20px;
            animation: fall linear infinite;
            pointer-events: none;
        }
        @keyframes fall { to { transform: translateY(100vh) rotate(360deg); } }
        
        button {
            background: #ff4081;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            font-family: 'Quicksand', sans-serif;
            font-weight: bold;
            cursor: pointer;
            margin-top: 15px;
            box-shadow: 0 4px 10px rgba(233, 30, 99, 0.3);
        }
    </style>
</head>
<body>

    <audio id="backsound" loop>
        <source src="musik.mp3" type="audio/mpeg">
    </audio>

    <div class="card">
        <h1>Hai Sayangku Luna ✨</h1>
        
        <div class="photo-container">
            <img src="Foto Lumoy 1.jpg" class="active">
            <img src="foto2.jpg">
            <img src="foto3.jpg">
        </div>

        <p id="typing-text"></p>
        
        <button onclick="mulaiSemuanya()">Klik untuk Kejutan 💖</button>
        
        <div id="pesan-akhir" style="display:none; margin-top:20px; color:#e91e63;">
            <p><i>"Kamu itu seperti sinyal 5G, <br> bikin duniaku jadi cepat dan indah!"</i></p>
        </div>
    </div>

    <script>
        // 1. Logika Ganti Foto Otomatis (Slider)
        let slideIndex = 0;
        function showSlides() {
            let slides = document.querySelectorAll(".photo-container img");
            slides.forEach(img => img.classList.remove("active"));
            slideIndex++;
            if (slideIndex > slides.length) {slideIndex = 1}
            slides[slideIndex-1].classList.add("active");
            setTimeout(showSlides, 3000); // Ganti foto tiap 3 detik
        }

        // 2. Logika Efek Ngetik yang Panjang
        const pesan = "Aku cuma mau bilang makasih banyak ya udah selalu ada. Kamu adalah alasan kenapa kuliah dan praktikumku terasa lebih ringan. Semoga kita terus begini ya... Love you! ❤️";
        let i = 0;
        function typing() {
            if (i < pesan.length) {
                document.getElementById("typing-text").innerHTML += pesan.charAt(i);
                i++;
                setTimeout(typing, 80);
            }
        }

        // 3. Fungsi Utama saat Tombol Diklik
        function mulaiSemuanya() {
            // Putar Musik
            document.getElementById("backsound").play();
            // Jalankan Ngetik
            document.getElementById("typing-text").innerHTML = "";
            i = 0;
            typing();
            // Tampilkan Pesan Akhir
            document.getElementById("pesan-akhir").style.display = "block";
            // Jalankan Slider Foto
            showSlides();
            // Hujan Hati
            setInterval(createHeart, 300);
        }

        function createHeart() {
            const heart = document.createElement('div');
            heart.classList.add('heart');
            heart.innerHTML = '🌸'; // Pakai bunga biar lucu
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.animationDuration = Math.random() * 2 + 3 + 's';
            document.body.appendChild(heart);
            setTimeout(() => { heart.remove(); }, 5000);
        }
    </script>
</body>
</html>
